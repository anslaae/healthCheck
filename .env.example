# GitHub OAuth (required for login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Long random string used to sign session ID cookies in the BFF (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=

# Optional. If empty, the API will infer origin from request headers.
# Example: https://your-app.vercel.app
APP_BASE_URL=

# Preferred Redis env vars for @upstash/redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
